   "source": [
    "function gcd(x: number, y: number): number {\n",
    "    while (y !== 0) {\n",
    "        const temp = y;\n",
    "        y = x % y;\n",
    "        x = temp;\n",
    "    }\n",
    "    return x;\n",
    "}"
   ]
  },
